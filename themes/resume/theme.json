{
	"$schema": "https://schemas.wp.org/wp/7.0/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"palette": [
				{
					"color": "#058ed9",
					"name": "Primary",
					"slug": "primary"
				},
				{
					"color": "#06D6A0",
					"name": "Secondary",
					"slug": "secondary"
				},
				{
					"color": "#e9ecef",
					"name": "Base",
					"slug": "base"
				},
				{
					"color": "#212529",
					"name": "Contrast",
					"slug": "contrast"
				}
			]
		},
		"custom": {
            "color": {
                "primary-dark": "#38b6ff",
                "secondary-dark": "#05b386",
                "base-dark": "#212529",
                "contrast-dark": "#f8f9fa",
				"white-dark": "#011c2b"
            }
        },
		"layout": {
			"contentSize": "920px",
			"wideSize": "1400px"
		},
		"spacing": {
			"units": [
				"%",
				"px",
				"em",
				"rem",
				"vh",
				"vw"
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen-Sans, Ubuntu, Cantarell, 'Helvetica Neue', sans-serif",
					"name": "System Font",
					"slug": "system-font"
				},
				{
					"fontFace": [
						{
							"fontFamily": "\"Open Sans\"",
							"fontStyle": "normal",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/open-sans/open-sans-400-normal.woff2"
							]
						},
						{
							"fontFamily": "\"Open Sans\"",
							"fontStyle": "normal",
							"fontWeight": "500",
							"src": [
								"file:./assets/fonts/open-sans/open-sans-500-normal.woff2"
							]
						},
						{
							"fontFamily": "\"Open Sans\"",
							"fontStyle": "normal",
							"fontWeight": "600",
							"src": [
								"file:./assets/fonts/open-sans/open-sans-600-normal.woff2"
							]
						},
						{
							"fontFamily": "\"Open Sans\"",
							"fontStyle": "normal",
							"fontWeight": "700",
							"src": [
								"file:./assets/fonts/open-sans/open-sans-700-normal.woff2"
							]
						}
					],
					"fontFamily": "\"Open Sans\", sans-serif",
					"name": "Open Sans",
					"slug": "open-sans"
				},
				{
					"fontFace": [
						{
							"fontFamily": "\"Noto Serif\"",
							"fontStyle": "normal",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/noto-serif/noto-serif-400-normal.woff2"
							]
						},
						{
							"fontFamily": "\"Noto Serif\"",
							"fontStyle": "normal",
							"fontWeight": "500",
							"src": [
								"file:./assets/fonts/noto-serif/noto-serif-500-normal.woff2"
							]
						},
						{
							"fontFamily": "\"Noto Serif\"",
							"fontStyle": "normal",
							"fontWeight": "600",
							"src": [
								"file:./assets/fonts/noto-serif/noto-serif-600-normal.woff2"
							]
						},
						{
							"fontFamily": "\"Noto Serif\"",
							"fontStyle": "normal",
							"fontWeight": "700",
							"src": [
								"file:./assets/fonts/noto-serif/noto-serif-700-normal.woff2"
							]
						},
						{
							"fontFamily": "\"Noto Serif\"",
							"fontStyle": "normal",
							"fontWeight": "800",
							"src": [
								"file:./assets/fonts/noto-serif/noto-serif-800-normal.woff2"
							]
						}
					],
					"fontFamily": "\"Noto Serif\", serif",
					"name": "Noto Serif",
					"slug": "noto-serif"
				}
			]
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|open-sans"
		}
	},
	"templateParts": [
		{
			"area": "header",
			"name": "header"
		},
		{
			"area": "footer",
			"name": "footer"
		}
	]
}