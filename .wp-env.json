{
  "$schema": "https://schemas.wp.org/trunk/wp-env.json",
  "core": null,
  "port": 8890,
  "testsEnvironment": false,
  "multisite": true,
  "themes": [
    "https://downloads.wordpress.org/theme/frost.zip",
    "./themes/personal-theme",
    "./themes/resume"
  ],
  "plugins": [
    "https://downloads.wordpress.org/plugin/dark-mode-toggle-block.zip",
    "https://downloads.wordpress.org/plugin/translatepress-multilingual.zip",
    "https://downloads.wordpress.org/plugin/wordpress-seo.zip"
  ],
  "mappings": {
    "wp-content/mu-plugins": "./mu-plugins"
  },
  "config": {
    "DOCRAPTOR_TEST_MODE": true
  },
  "lifecycleScripts": {
    "afterStart": "node bin/wp-env-after-start.js"
  }
}
